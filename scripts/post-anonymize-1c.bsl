// post-anonymize-1c.bsl
//
// Модуль внешней обработки для headless-запуска (1cv8 ENTERPRISE ... /Execute).
// Платформенная замена шагу "Post-anonymization sql script" из anonymize-pipeline.sh:
// вместо прямых SQL-команд к таблицам СУБД (v8users, _ConfigChngR, _AccumRegChgR,
// _InfoRgChgR) выполняет ту же задачу штатными средствами 1С:Предприятие —
// через объектную модель платформы, без обращения к СУБД в обход платформы
// (см. правила публикации Infostart.ru: запрет прямого доступа к СУБД 1С).
//
// Сборка: откройте этот модуль в 1C:Designer/EDT как модуль внешней обработки
// и сохраните как post-anonymize-1c.epf. Путь к готовому .epf передаётся
// в anonymize-pipeline.sh переменной POST_ANONYMIZE_EPF.

#Область ПрограммныйИнтерфейс

// Точка входа: 1cv8 ENTERPRISE /S"host/stage_anonymized_1c" /N"Администратор" /P""
//               /Execute "post-anonymize-1c.epf"
Процедура ВыполнитьПостОбработку() Экспорт

	СброситьПаролиПользователей();
	ОчиститьРегистрациюИзмененийПлановОбмена();

	ЗавершитьРаботуСистемы(Ложь);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедуры

// Платформенный аналог "UPDATE v8users SET password = ''".
// Сбрасывает пароли всех пользователей ИБ, чтобы разработчики могли
// беспрепятственно зайти в копию базы для разработки.
Процедура СброситьПаролиПользователей()

	Для Каждого ПользовательИБ Из ИнформационнаяБаза.ПользователиИнформационнойБазы.ПолучитьПользователи() Цикл
		Попытка
			ПользовательИБ.УстановитьПароль("");
			ПользовательИБ.ЗаписатьПользователя();
		Исключение
			ЗаписьЖурналаРегистрации("ОбезличиваниеБД.СбросПароля",
				УровеньЖурналаРегистрации.Предупреждение,,,
				"Не удалось сбросить пароль пользователя """ + ПользовательИБ.Имя + """: " + ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры

// Платформенный аналог "DELETE FROM _ConfigChngR / _AccumRegChgR / _InfoRgChgR".
// Штатный метод ПланыОбмена.УдалитьРегистрациюИзменений() снимает регистрацию
// изменений для узла независимо от того, в каких служебных таблицах СУБД
// платформа физически её хранит — не требует прямого знания схемы СУБД
// и остаётся корректным при смене версии платформы/СУБД.
Процедура ОчиститьРегистрациюИзмененийПлановОбмена()

	Для Каждого МетаданныеПланаОбмена Из Метаданные.ПланыОбмена Цикл

		МенеджерПлана = ПланыОбмена[МетаданныеПланаОбмена.Имя];
		Выборка = МенеджерПлана.ВыбратьУзлы();

		Пока Выборка.Следующий() Цикл
			Если Выборка.Ссылка <> МенеджерПлана.ЭтотУзел() Тогда
				Попытка
					ПланыОбмена.УдалитьРегистрациюИзменений(Выборка.Ссылка);
				Исключение
					ЗаписьЖурналаРегистрации("ОбезличиваниеБД.ОчисткаРегистрации",
						УровеньЖурналаРегистрации.Предупреждение,,,
						"Не удалось очистить регистрацию изменений для узла """
						+ Выборка.Ссылка + """ плана обмена """
						+ МетаданныеПланаОбмена.Имя + """: " + ОписаниеОшибки());
				КонецПопытки;
			КонецЕсли;
		КонецЦикла;

	КонецЦикла;

КонецПроцедуры

#КонецОбласти
