<?xml version="1.0" encoding="UTF-8"?>
<config xmlns="http://v8.1c.ru/v8/tech-log">
  <!-- Создание минидампов при аварийных завершениях -->
  <dump create="true" location="/var/1c/dumps" type="3" prntscr="false"/>
  
  <!-- Запись ТЖ с глубокой историей ротации (48 часов) -->
  <log location="/var/log/1c_tech_log" history="48">
    <!-- Слой 1: Тяжелые серверные вызовы CALL/SCALL > 100 МБ -->
    <event>
      <eq property="Name" value="CALL"/>
      <gt property="Memory" value="104857600"/>
    </event>
    <event>
      <eq property="Name" value="SCALL"/>
      <gt property="Memory" value="104857600"/>
    </event>
    
    <!-- Слой 2: Тяжелые запросы PostgreSQL > 50 МБ или > 5 секунд -->
    <event>
      <eq property="Name" value="DBPOSTGRS"/>
      <gt property="Memory" value="52428800"/>
    </event>
    <event>
      <eq property="Name" value="DBPOSTGRS"/>
      <gt property="Duration" value="5000000"/>
    </event>
    
    <!-- Слой 3: Управление блокировками СУБД (TLOCK/TDEADLOCK) -->
    <event>
      <eq property="Name" value="TLOCK"/>
      <gt property="WaitConnections" value="0"/>
    </event>
    <event>
      <eq property="Name" value="TDEADLOCK"/>
    </event>
    
    <!-- Слой 4: Системные сбои и принудительные отключения (EXCP/ATTN) -->
    <event>
      <eq property="Name" value="EXCP"/>
    </event>
    <event>
      <eq property="Name" value="ATTN"/>
    </event>
    
    <!-- Спецификация выгружаемых свойств для сквозного расследования -->
    <properties>
      <property name="p:processName"/>
      <property name="t:connectID"/>
      <property name="SessionID"/>
      <property name="Usr"/>
      <property name="Memory"/>
      <property name="MemoryPeak"/>
      <property name="Duration"/>
      <property name="Context"/>
      <property name="Sql"/>
      <property name="WaitConnections"/>
      <property name="Exception"/>
      <property name="Descr"/>
    </properties>
  </log>
</config>
